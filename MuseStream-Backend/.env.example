# Copy this file to ".env" (same folder as pom.xml) and edit the values.
# Spring Boot loads it automatically when you run the app from the project root.

DB_URL=jdbc:postgresql://localhost:5432/musestream
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

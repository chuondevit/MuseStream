    {
      "name": "3. Onboarding (first login)",
      "item": [
        {
          "name": "Onboarding options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/onboarding/options",
              "host": [

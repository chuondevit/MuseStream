                "onboarding",
                "options"
              ]
            }
          }
        },
        {
          "name": "Save onboarding choices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommendations/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations",
                "onboarding"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favoriteSongIds\": [\n    1,\n    4,\n    7\n  ],\n  \"favoriteArtistIds\": [\n    1,\n    3\n  ],\n  \"genreIds\": [\n    1,\n    2\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs at least 3 songs, 1 artist and 1 genre. Sets onboardingCompleted = true."
          }
        },
        {
          "name": "My preferences",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/preferences",

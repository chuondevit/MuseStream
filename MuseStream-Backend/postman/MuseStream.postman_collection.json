            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favoriteSongIds\": [\n    10,\n    13,\n    16\n  ],\n  \"favoriteArtistIds\": [\n    5\n  ],\n  \"genreIds\": [\n    3,\n    8\n  ]\n}",

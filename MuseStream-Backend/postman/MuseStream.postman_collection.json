              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Late Night Coding\",\n  \"description\": \"Focus beats\",\n  \"isPublic\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('playlistId', json.id);"
                ]
              }
            }
          ]
